<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>UY UNITY Logistics V3</title>
<style>
*{box-sizing:border-box}
:root{--bg:#050505;--card:#111;--input:#1b1b1b;--txt:#fff;--muted:#aaa;--line:#2b2b2b}
body.light{--bg:#f5f5f5;--card:#fff;--input:#eee;--txt:#111;--muted:#666;--line:#d5d5d5}
html,body{margin:0;background:var(--bg);color:var(--txt);font-family:Arial,sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer;-webkit-tap-highlight-color:transparent}
.app{max-width:560px;margin:auto;min-height:100vh;padding-bottom:82px}
header{height:66px;padding:12px 15px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:var(--bg);position:sticky;top:0;z-index:5}
.logo{font-weight:900;letter-spacing:1.5px;font-size:20px}.logo small{display:block;color:var(--muted);font-size:9px;letter-spacing:2px;margin-top:2px}
.icon{width:42px;height:42px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--txt)}
main{padding:16px}
.page{display:none}.page.active{display:block}
.hero,.box,.order{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:13px}
.hero h1{margin:0 0 7px;font-size:24px}.hero p{margin:0;color:var(--muted);line-height:1.45}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{min-height:115px;text-align:left;padding:15px;background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:17px}
.tile b{display:block;margin:9px 0 5px}.tile span{font-size:12px;color:var(--muted);line-height:1.35}
.emoji{font-size:24px}
h2{font-size:18px;margin:18px 2px 10px}
label{display:block;font-size:13px;font-weight:bold;margin:13px 0 6px}
input,textarea,select{width:100%;padding:13px;border-radius:11px;border:1px solid var(--line);background:var(--input);color:var(--txt);outline:0}
textarea{min-height:85px;resize:vertical}.row{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.btn{width:100%;padding:14px;margin-top:12px;border-radius:12px;font-weight:800;border:1px solid var(--line);background:var(--input);color:var(--txt)}
.primary{background:var(--txt);color:var(--bg);border-color:var(--txt)}
.success,.error{display:none;margin-top:12px;padding:12px;border-radius:11px;font-size:13px;line-height:1.4}
.success{background:#173017;color:#caffca}.error{background:#351717;color:#ffcaca}
.send{border-top:1px solid var(--line);margin-top:18px;padding-top:15px}
.send h3{margin:0 0 4px}.send p,.hint{font-size:11px;color:var(--muted);line-height:1.45}
.order-top{display:flex;justify-content:space-between;gap:8px}.tag{font-size:10px;background:var(--input);padding:6px 8px;border-radius:20px}
.order p{font-size:12px;line-height:1.45;color:var(--muted)}
.themes{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.theme{padding:14px;border:1px solid var(--line);border-radius:12px;background:var(--input);color:var(--txt);font-weight:bold}.theme.selected{outline:2px solid var(--txt)}
.bottom{position:fixed;bottom:0;left:0;right:0;height:70px;background:var(--card);border-top:1px solid var(--line);z-index:8}
.nav{max-width:560px;margin:auto;height:100%;display:grid;grid-template-columns:repeat(4,1fr)}
.nav button{border:0;background:transparent;color:var(--muted);font-size:11px}.nav button span{display:block;font-size:20px;margin-bottom:3px}.nav button.active{color:var(--txt);font-weight:bold}
.empty{text-align:center;color:var(--muted);padding:35px}
@media(max-width:390px){.row{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<header>
<div class="logo">UY UNITY<small>LOGISTICS</small></div>
<button class="icon" id="settingsTop" type="button">⚙️</button>
</header>

<main>
<!-- HOME -->
<section class="page active" id="home">
<div class="hero"><h1>UY UNITY Logistics 🚚</h1><p>Simple delivery management for customers.</p></div>
<div class="grid">
<button class="tile" type="button" data-go="delivery"><div class="emoji">📦</div><b>New Delivery</b><span>Create a delivery order.</span></button>
<button class="tile" type="button" data-go="orders"><div class="emoji">📋</div><b>Orders</b><span>View saved delivery orders.</span></button>
<button class="tile" type="button" data-go="track"><div class="emoji">📍</div><b>Track</b><span>Check an order ID.</span></button>
<button class="tile" type="button" data-go="settings"><div class="emoji">⚙️</div><b>Settings</b><span>Change light/dark theme.</span></button>
</div>
</section>

<!-- DELIVERY -->
<section class="page" id="delivery">
<div class="hero"><h1>New Delivery</h1><p>Enter details.</p></div>
<div class="box">
<form id="deliveryForm">
<label>Customer name *</label>
<input id="customerName" required placeholder="Full name">
<label>Phone number *</label>
<input id="customerPhone" required type="tel" placeholder="08012345678">
<label>Delivery address *</label>
<textarea id="address" required placeholder="House number, street, area, landmark"></textarea>
<div class="row">
<div><label>City *</label><input id="city" required placeholder="Benin City"></div>
<div><label>State *</label><input id="state" required placeholder="Edo"></div>
</div>
<label>Package / order *</label>
<textarea id="package" required placeholder="Product, quantity, size, colour, etc."></textarea>
<div class="row">
<div><label>Amount (₦)</label><input id="amount" type="number" min="0" placeholder="0"></div>
<div><label>Payment</label>
<select id="payment"><option>Payment on delivery</option><option>Bank transfer</option><option>Already paid</option></select>
</div></div>
<label>Delivery note</label>
<textarea id="note" placeholder="Optional rider instruction"></textarea>
<button class="btn primary" id="createBtn" type="submit">Create Order</button>
</form>

<div id="created" class="success"></div>
<div id="sendPanel" class="send" style="display:none">
<h3>Send Order</h3>
<p>Tap one option. The order will be placed into that app's message/email composer.</p>
<button class="btn" id="gmailBtn" type="button">📧 Send with Gmail</button>
<button class="btn" id="smsBtn" type="button">📱 Send by SMS</button>
<button class="btn" id="waBtn" type="button">💬 Send with WhatsApp</button>
</div>
<div id="deliveryError" class="error"></div>
</div>
</section>

<!-- ORDERS -->
<section class="page" id="orders">
<div class="hero"><h1>Orders</h1><p>Orders created on this device.</p></div>
<div id="ordersList"></div>
</section>

<!-- TRACK -->
<section class="page" id="track">
<div class="hero"><h1>Track Delivery</h1><p>Search an order saved on this device.</p></div>
<div class="box">
<label>Order ID</label>
<input id="searchId" placeholder="UY-123456">
<button class="btn primary" id="trackBtn" type="button">Check Status</button>
<div id="trackResult" class="success"></div>
</div>
</section>

<!-- SETTINGS -->
<section class="page" id="settings">
<div class="hero"><h1>Settings</h1><p>Choose your app appearance.</p></div>
<div class="box">
<b>🎨 Theme</b>
<p class="hint">V3 has only Light and Dark.</p>
<div class="themes">
<button class="theme" type="button" data-theme="dark">🌙 Dark</button>
<button class="theme" type="button" data-theme="light">☀️ Light</button>
</div>
</div>
<div class="box">
<b>📞 Business sending details</b>
<p class="hint">SMS and WhatsApp currently use the UY UNITY business number saved in this file. Gmail uses the email address saved in this file.</p>
</div>
</section>
</main>
</div>

<div class="bottom"><div class="nav">
<button type="button" data-nav="home" class="active"><span>⌂</span>Home</button>
<button type="button" data-nav="delivery"><span>🚚</span>Delivery</button>
<button type="button" data-nav="orders"><span>📋</span>Orders</button>
<button type="button" data-nav="settings"><span>⚙️</span>Settings</button>
</div></div>

<script>
/* ===== BUSINESS DETAILS ===== */
const BUSINESS_EMAIL = "uwaosakpamwan79@gmail.com";
const BUSINESS_PHONE = "+2347044480531";

/* ===== SIMPLE PAGE NAVIGATION ===== */
function openPage(id){
  document.querySelectorAll(".page").forEach(function(p){p.classList.remove("active");});
  var page=document.getElementById(id);
  if(page) page.classList.add("active");
  document.querySelectorAll("[data-nav]").forEach(function(b){
    b.classList.toggle("active",b.getAttribute("data-nav")===id);
  });
  window.scrollTo(0,0);
}
document.querySelectorAll("[data-go]").forEach(function(b){
  b.addEventListener("click",function(){openPage(b.getAttribute("data-go"));});
});
document.querySelectorAll("[data-nav]").forEach(function(b){
  b.addEventListener("click",function(){openPage(b.getAttribute("data-nav"));});
});
document.getElementById("settingsTop").addEventListener("click",function(){openPage("settings");});

/* ===== THEME ===== */
function applyTheme(t){
  if(t==="light") document.body.classList.add("light");
  else document.body.classList.remove("light");
  localStorage.setItem("uy_theme",t);
  document.querySelectorAll(".theme").forEach(function(b){
    b.classList.toggle("selected",b.getAttribute("data-theme")===t);
  });
}
document.querySelectorAll(".theme").forEach(function(b){
  b.addEventListener("click",function(){applyTheme(b.getAttribute("data-theme"));});
});
applyTheme(localStorage.getItem("uy_theme")||"dark");

/* ===== ORDER ===== */
var currentOrder=null;

function value(id){return document.getElementById(id).value.trim();}
function allOrders(){return JSON.parse(localStorage.getItem("uy_logistics_orders")||"[]");}
function saveOrder(o){
  var a=allOrders();a.unshift(o);
  localStorage.setItem("uy_logistics_orders",JSON.stringify(a.slice(0,100)));
}
function orderText(o){
 return "UY UNITY LOGISTICS ORDER\n\n"+
 "Order ID: "+o.id+"\n\n"+
 "CUSTOMER\nName: "+o.name+"\nPhone: "+o.phone+"\n\n"+
 "DELIVERY ADDRESS\n"+o.address+"\n"+o.city+", "+o.state+"\n\n"+
 "PACKAGE / ORDER\n"+o.package+"\n\n"+
 "AMOUNT: ₦"+Number(o.amount||0).toLocaleString("en-NG")+"\n"+
 "PAYMENT: "+o.payment+"\n\n"+
 "DELIVERY NOTE: "+(o.note||"None")+"\n\n"+
 "Date: "+o.date;
}

document.getElementById("deliveryForm").addEventListener("submit",function(e){
 e.preventDefault();
 currentOrder={
  id:"UY-"+Math.floor(100000+Math.random()*900000),
  name:value("customerName"),phone:value("customerPhone"),address:value("address"),
  city:value("city"),state:value("state"),package:value("package"),
  amount:value("amount")||"0",payment:value("payment"),note:value("note"),
  date:new Date().toLocaleString("en-NG"),status:"Created"
 };
 saveOrder(currentOrder);
 document.getElementById("created").style.display="block";
 document.getElementById("created").textContent="✅ Order "+currentOrder.id+" created. Choose Gmail, SMS or WhatsApp.";
 document.getElementById("sendPanel").style.display="block";
 document.getElementById("deliveryError").style.display="none";
});

/* ===== SEND WITH GMAIL ===== */
document.getElementById("gmailBtn").addEventListener("click",function(){
 if(!currentOrder)return;
 if(BUSINESS_EMAIL==="YOUR_GMAIL@gmail.com"){
   alert("Open the HTML code and replace YOUR_GMAIL@gmail.com with your UY UNITY Gmail address.");
   return;
 }
 var subject=encodeURIComponent("UY UNITY Logistics Order "+currentOrder.id);
 var body=encodeURIComponent(orderText(currentOrder));
 window.location.href="mailto:"+BUSINESS_EMAIL+"?subject="+subject+"&body="+body;
});

/* ===== SEND SMS ===== */
document.getElementById("smsBtn").addEventListener("click",function(){
 if(!currentOrder)return;
 var body=encodeURIComponent(orderText(currentOrder));
 window.location.href="sms:"+BUSINESS_PHONE+"?body="+body;
});

/* ===== SEND WHATSAPP ===== */
document.getElementById("waBtn").addEventListener("click",function(){
 if(!currentOrder)return;
 var digits=BUSINESS_PHONE.replace(/\D/g,"");
 var body=encodeURIComponent(orderText(currentOrder));
 window.location.href="https://wa.me/"+digits+"?text="+body;
});

/* ===== ORDER LIST ===== */
function escapeHTML(s){
 return String(s||"").replace(/[&<>"']/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c];
 });
}
function renderOrders(){
 var box=document.getElementById("ordersList"),a=allOrders();
 if(!a.length){box.innerHTML='<div class="empty">📦<br><br>No orders yet.</div>';return;}
 box.innerHTML=a.map(function(o){
  return '<div class="order"><div class="order-top"><b>'+escapeHTML(o.id)+'</b><span class="tag">'+escapeHTML(o.status)+'</span></div>'+
  '<p><b>'+escapeHTML(o.name)+'</b><br>📞 '+escapeHTML(o.phone)+'<br>📍 '+escapeHTML(o.address)+', '+escapeHTML(o.city)+', '+escapeHTML(o.state)+'<br>📦 '+escapeHTML(o.package)+'</p>'+
  '<p>'+escapeHTML(o.date)+'</p></div>';
 }).join("");
}
document.querySelector('[data-nav="orders"]').addEventListener("click",renderOrders);
document.querySelector('[data-go="orders"]').addEventListener("click",renderOrders);

/* ===== TRACK ===== */
document.getElementById("trackBtn").addEventListener("click",function(){
 var id=value("searchId").toUpperCase(),r=document.getElementById("trackResult");
 var o=allOrders().find(function(x){return x.id.toUpperCase()===id;});
 r.style.display="block";
 if(!id){r.textContent="Enter an order ID.";return;}
 if(!o){r.textContent="Order not found on this device.";return;}
 r.innerHTML="<b>"+escapeHTML(o.id)+"</b><br>Status: "+escapeHTML(o.status)+"<br>Customer: "+escapeHTML(o.name)+"<br>Destination: "+escapeHTML(o.city)+", "+escapeHTML(o.state);
});
</script>
</body>
</html>